  },
  {
    "name": "sem-guide",
    "kind": "adapted-upstream",
    "source": "https://github.com/wentorai/research-plugins/blob/bf44b3cd617fa94c8a1b254c5d1987142ca3d631/skills/analysis/statistics/sem-guide/SKILL.md",
    "upstream_commit": "bf44b3cd617fa94c8a1b254c5d1987142ca3d631",
