    "entry_sha256": "53561873a79faff84a6bde7ca75fc2d6d4aa6dfd5d28cb71660df74496195018",
    "license": "MIT (upstream)",
    "local_path": "skills/sem-guide",
    "correction": "不按固定 CFI/RMSEA 或 α 门槛宣告效度成立；不以同一数据反复删题后称为独立确认。横截面 SEM 的箭头或间接效应不能单独证明因果机制。"
  },
  {
    "name": "causal-inference-guide",
    "kind": "adapted-upstream",
    "source": "https://github.com/wentorai/research-plugins/blob/bf44b3cd617fa94c8a1b254c5d1987142ca3d631/skills/analysis/econometrics/causal-inference-guide/SKILL.md",
